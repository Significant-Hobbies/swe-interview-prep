{
  "name": "swe-interview-prep",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:wars-worker": "wrangler dev --config workers/software-wars/wrangler.jsonc --port 8788",
    "verify:sources": "node scripts/verify-sources.mjs",
    "verify:citations": "node scripts/verify-citations.mjs",
    "validate:wars-content": "node scripts/validate-software-wars-content.mjs",
    "audit:wars-topic": "node scripts/audit-software-wars-topic.mjs",
    "build": "pnpm generate:public-curriculum && node scripts/validate-env.mjs build && vite build",
    "lint": "biome check .",
    "preview": "vite preview",
    "fetch-library": "node scripts/fetch-library.mjs && node scripts/build-concept-index.mjs && biome format --write src/data/library",
    "build-concept-index": "node scripts/build-concept-index.mjs",
    "sync:external-resources": "node scripts/harvest-external-resources.mjs && node scripts/bootstrap-external-resources.mjs",
    "sync:concept-packs": "node scripts/generate-concept-packs.mjs && pnpm build:source-hubs",
    "build:source-hubs": "node scripts/build-source-hubs.mjs",
    "expand:learning-domains": "node scripts/expand-learning-domains.mjs && biome format --write src/data/artifacts.json src/data/concepts.json src/data/curriculum-coverage.json src/data/drills.json src/data/roadmaps.json",
    "generate:public-curriculum": "node scripts/generate-public-curriculum.mjs",
    "sync:learning-sources": "node --experimental-strip-types scripts/sync-learning-sources.mjs",
    "ingest-anki": "node scripts/ingest-anki.mjs",
    "ingest-leetcode": "node scripts/ingest-leetcode.mjs",
    "link-leetcode-drills": "node scripts/link-leetcode-drills.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:env:build": "node scripts/validate-env.mjs build",
    "validate:env:runtime": "node scripts/validate-env.mjs runtime",
    "validate:env:deploy": "node scripts/validate-env.mjs deploy",
    "validate:d1:deploy": "node scripts/validate-d1-config.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.toml",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:prepare-import": "node scripts/prepare-d1-import.mjs",
    "dev:pages": "pnpm build && pnpm db:migrate:local && wrangler pages dev dist --d1 DB=local",
    "ready": "node scripts/check-ready.mjs",
    "sync:pages-secrets": "node scripts/sync-pages-secrets.mjs",
    "deploy": "pnpm validate:env:deploy && pnpm validate:d1:deploy && pnpm build && pnpm db:migrate:remote && pnpm exec wrangler pages deploy dist/ --project-name=swe-interview-prep",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "size": "size-limit",
    "size:check": "size-limit --json",
    "docs:validate": "node scripts/validate-docs.mjs",
    "docs:build": "blume build --output static --base /docs",
    "docs:preview": "blume preview",
    "docs:check": "blume check",
    "knip": "knip --no-exit-code --reporter symbols",
    "knip:strict": "knip --reporter symbols"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.41",
    "@cloudflare/realtimekit": "2.0.1",
    "@cloudflare/realtimekit-react": "2.0.1",
    "@excalidraw/excalidraw": "0.18.1",
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@saas-maker/feedback": "^0.2.1",
    "ai": "6.0.168",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "google-auth-library": "10.9.1",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "1.27.0",
    "lz-string": "1.5.0",
    "posthog-js": "^1.407.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.2",
    "react-router-dom": "7.18.1",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "sql.js": "^1.14.1",
    "sucrase": "3.35.1",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "5.4.1",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.62.0",
    "@size-limit/file": "^11.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/lz-string": "1.5.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19",
    "@types/sql.js": "^1.4.11",
    "@vercel/node": "5.8.27",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "astro": "5.18.2",
    "blume": "1.2.0",
    "happy-dom": "20.11.1",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "lightningcss": "^1.33.0",
    "prettier": "3.9.6",
    "size-limit": "^11.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "ultracite": "7.10.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowAny": [
        "react",
        "react-dom"
      ]
    }
  },
  "packageManager": "pnpm@10.33.2"
}
