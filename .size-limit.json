[
  {
    "name": "Initial app entry",
    "path": "dist/assets/index-*.js",
    "limit": "40 kB",
    "gzip": true
  },
  {
    "name": "Initial React vendor",
    "path": "dist/assets/vendor-react-*.js",
    "limit": "90 kB",
    "gzip": true
  },
  {
    "name": "Initial icon vendor",
    "path": "dist/assets/vendor-lucide-*.js",
    "limit": "15 kB",
    "gzip": true
  },
  {
    "name": "Initial runtime",
    "path": "dist/assets/rolldown-runtime-*.js",
    "limit": "2 kB",
    "gzip": true
  },
  {
    "name": "Learning app CSS",
    "path": [
      "dist/assets/*.css",
      "!dist/assets/Scale-*.css"
    ],
    "limit": "50 KB",
    "gzip": true
  },
  {
    "name": "Lazy Scale CSS",
    "path": "dist/assets/Scale-*.css",
    "limit": "10 kB",
    "gzip": true
  },
  {
    "name": "Lazy Scale interface",
    "path": "dist/assets/Scale-*.js",
    "limit": "33 kB",
    "gzip": true
  },
  {
    "name": "Scale simulation worker",
    "path": "dist/assets/worker-*.js",
    "limit": "40 kB",
    "gzip": true
  }
]
