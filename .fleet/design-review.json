{
  "$schema": "fleet.design-review.v1",
  "version": 1,
  "project": "swe-interview-prep",
  "target": "Today learning session",
  "mode": "preserve",
  "register": "product",
  "context": {
    "product": "PRODUCT.md",
    "design": "DESIGN.md"
