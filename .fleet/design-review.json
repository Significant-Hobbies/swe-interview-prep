{
  "$schema": "fleet.design-review.v1",
  "version": 1,
  "project": "swe-interview-prep",
  "target": "Systems Lab catalog and runner",
  "mode": "preserve",
  "register": "product",
  "context": {
    "product": "PRODUCT.md",
    "design": "DESIGN.md"
  },
  "direction": {
    "references": [],
    "probes": [],
    "selected": "existing-design",
    "approval": "not-required",
    "before": "artifacts/design/before.png"
  },
  "evidence": {
    "screenshots": [
      {
        "width": 390,
        "path": "artifacts/design/systems-lab-after-390.png"
      },
      {
        "width": 768,
        "path": "artifacts/design/systems-lab-after-768.png"
      },
      {
        "width": 1440,
        "path": "artifacts/design/systems-lab-after-1440.png"
      }
    ],
    "projectCheck": {
      "command": "pnpm test && pnpm typecheck && pnpm lint && pnpm docs:validate && pnpm build",
      "status": "pass"
    },
    "critique": {
      "score": 0,
      "maximum": 40
    },
    "audit": {
      "score": 17,
      "maximum": 20
    },
    "unresolved": {
      "p0": 0,
      "p1": 0
    },
    "detector": {
      "posture": "advisory",
      "findings": [
        {
          "rule": "design-system-font-size",
          "count": 23,
          "disposition": "resolved",
          "note": "Recorded the incumbent 10px and 11px signal-label steps in DESIGN.md."
        },
        {
          "rule": "gray-on-color",
          "count": 2,
          "disposition": "pre-existing",
          "note": "Both findings point to unchanged Build Lab code outside the Systems Lab feature."
        }
      ]
    }
  },
  "ownerFeedback": {
    "decision": "delegated",
    "note": "Owner explicitly delegated implementation with 'go for it, lets see' on 2026-07-30."
  }
}
