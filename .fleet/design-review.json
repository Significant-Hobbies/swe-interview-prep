        },
        {
          "rule": "undocumented-color-literals",
          "count": 3,
          "disposition": "pre-existing",
          "note": "The detector found existing standalone cyan and scrollbar literals."
        }
      ]
    }
  },
  "ownerFeedback": {
    "decision": "delegated",
    "note": "Owner explicitly delegated the remediation with 'Go for it. Do all of them until there is at least something.' on 2026-07-31."
